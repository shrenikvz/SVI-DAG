# ===========================================================================
# Case 2 -- SVI-DAG vs 5 baselines, linear-Gaussian ER (p=25, s=40), CPDAG metrics
#
# The exact hyperparameters required to reproduce case 2. Sourced automatically
# by ./run_local.sh 2 and by run_case2.sh. Any variable not set here takes its
# committed value from src/svidag/config.py.
# ===========================================================================

# Clear any SVIDAG_* inherited from the shell so this file alone determines the
# configuration (the cases do not all set the same variables).
for _v in $(env | sed -n 's/^\(SVIDAG_[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$_v"; done
unset _v

# --- SVI-DAG --------------------------------------------------------------
export SVIDAG_LR=3e-3
export SVIDAG_GRAD_CLIP=1.0
export SVIDAG_BATCH_SIZE=64
export SVIDAG_FLOW_HIDDEN=64
export SVIDAG_FLOW_BLOCKS=5
export SVIDAG_FLOW_TYPE=nsf_coupling
export SVIDAG_N_PARTICLES=20
export SVIDAG_SINKHORN_ITERS=100
export SVIDAG_PRIOR_R_SIGMA=1.0
export SVIDAG_PARTICLE_CLIP_MODE=norm
export SVIDAG_PARTICLE_CLIP=10.0
export SVIDAG_ETA_R=1e-1
export SVIDAG_SCALE_INV=1
export SVIDAG_T_B=0.3
export SVIDAG_TAU_START=0.1
export SVIDAG_TAU_END=0.1
export SVIDAG_TAU_ANNEAL_FRAC=1.0
export SVIDAG_ST_WARMUP=1.0
export SVIDAG_ROW_ONLY=1
export SVIDAG_PRIOR_P0=0.025
export SVIDAG_PRIOR_NU=20
export SVIDAG_NUM_ITERS=1500
export SVIDAG_LEARN_NOISE=0
export SVIDAG_OBS_NOISE=0.5
export SVIDAG_KL_THETA=0.01
export SVIDAG_POSTERIOR_BIAS_LOG10_SLOPE=0.75
export SVIDAG_POSTERIOR_BIAS_REFERENCE_N=100
export SVIDAG_POSTERIOR_BIAS_FLOOR=-1.5
export SVIDAG_EVAL_EVERY=100
export SVIDAG_PATIENCE=100000

# --- Data generation ------------------------------------------------------
export CASE2_SEED=0
export CASE2_NUM_REPLICATES=5

# --- BayesDAG -------------------------------------------------------------
# Read only by paper_results_reproduce/case_4/baselines/bayesdag_wrapper.py.
export BAYESDAG_EPOCHS=150
export BAYESDAG_GRID_EPOCHS=25
export BAYESDAG_NLAMBDA=4
export BAYESDAG_GRID_SAMPLES=64
